    <string name="rdp_intro_title">DualDesk: a remote desktop client</string>
    <string name="project_url_bug_reports" translatable="false">https://github.com/Endymi0n74/DualDesk/issues</string>
    <string name="project_url_share" translatable="false">https://github.com/Endymi0n74/DualDesk</string>
    <string name="project_url_help_forum" translatable="false"></string>
    <string name="project_url_releases" translatable="false"></string>
